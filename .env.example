# ── Required ──────────────────────────────────────────────────────────────
# Google AI Studio key with access to the Gemini Live API.
# Get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# UI and operator language: "es" (rioplatense Spanish) or "en".
CC_LANG=en

# Operator voice. Any Gemini Live prebuilt voice, e.g.
# Callirrhoe, Kore, Aoede, Leda, Autonoe, Despina, Puck, Charon, Orus, Iapetus.
CC_VOICE=Callirrhoe

# Port the local server listens on.
CC_PORT=8765

# Seconds to wait between calls, so it doesn't drain the whole queue at once.
CC_COOLDOWN=90

# Hard limit for a single call, in seconds.
CC_MAX_CALL=300

# Comma-separated Herdr pane IDs to never call about (e.g. wA:p1,wB:p3).
# The pane running Claude Center excludes itself automatically.
CC_IGNORE=

# Only call about agents that get stuck from now on, ignoring the ones
# already waiting when the server starts. Set to 1 to enable.
CC_ONLY_NEW=
